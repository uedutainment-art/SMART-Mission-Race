{
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "site": "smart-mission-race-57839",
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      { "source": "/api/mobile-photo-action", "function": "mobilePhotoAction" },
      { "source": "/api/hq-chat-send", "function": "hqChatSend" },
      { "source": "/photo_upload", "destination": "/photo_upload.html" },
      { "source": "/photo_approve", "destination": "/photo_approve.html" },
      { "source": "/review", "destination": "/review.html" },
      { "source": "/dashboard", "destination": "/dashboard.html" },
      { "source": "/hq", "destination": "/hq.html" },
      { "source": "/admin", "destination": "/admin.html" },
      { "source": "/team_login", "destination": "/team_login.html" }
    ]
  }
}
